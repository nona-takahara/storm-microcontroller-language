{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "folding": {
    "markers": {
      "start": "^\\s*module\\b",
      "end": "^\\s*end\\b"
    }
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
